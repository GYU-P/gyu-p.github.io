---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../data/site';
import { works, workRoles, type Work } from '../data/works';
import InkBorder from '../components/InkBorder.astro';
import { localUrl } from '../utils/url';

const sections = [
  { kind: 'provided', title: '提供曲' },
  { kind: 'original', title: 'オリジナル曲' },
] as const;
const publishedWorks = works.filter(work => !work.sample).sort((a, b) => b.latest - a.latest);
const byViews = (a: Work, b: Work) => (b.viewCount ?? -1) - (a.viewCount ?? -1) || b.latest - a.latest;
const providedGroups = new Map<string, Work[]>();
for (const work of publishedWorks.filter(work => work.kind === 'provided')) {
  const singer = work.artist?.normalize('NFKC').trim() || work.id;
  const group = providedGroups.get(singer) ?? [];
  group.push(work);
  providedGroups.set(singer, group);
}
const providedWorks = [...providedGroups.values()]
  .map(group => group.sort(byViews))
  .sort((a, b) => byViews(a[0], b[0]))
  .flat();
const originalWorks = publishedWorks.filter(work => work.kind === 'original');
function responsibilities(work: Work) {
  return workRoles(work).join('・');
}
---
<SiteLayout page="profile" title="PROFILE">
  <section class="page-copy" aria-labelledby="page-title">
    <h1 id="page-title">PROFILE</h1>
    <p class="profile-name">GYU P</p>
    <div class="profile-biography">
      {site.biography.split('\n').map(line => (
        <p>{line.split('(詳細はWORKSをご覧ください)').map((part, index) => (
          <>{index > 0 && <span class="profile-biography__note">(詳細は<a href={localUrl('/')}>WORKS</a>をご覧ください)</span>}{part}</>
        ))}</p>
      ))}
    </div>
    <nav class="profile-socials" aria-label="SNS">
      <a href="https://x.com/GYUP_bokaroP" target="_blank" rel="noopener noreferrer">X ↗</a>
      <a href="https://www.youtube.com/@gyup_bokaroP" target="_blank" rel="noopener noreferrer">YouTube ↗</a>
    </nav>
    {sections.map(section => (
      <section class="profile-discography" aria-labelledby={`profile-${section.kind}`}>
        <div class="profile-discography__heading">
          <h2 id={`profile-${section.kind}`}>{section.title}</h2>
          <span class="profile-discography__rule"><InkBorder shape="line" /></span>
        </div>
        <ul>
          {(section.kind === 'provided' ? providedWorks : originalWorks).map(work => (
            <li>
              {work.url ? (
                <a href={work.url} target="_blank" rel="noopener noreferrer">{work.title} / {work.artist} <span class="profile-discography__credits">({responsibilities(work)})</span><span class="visually-hidden">（YouTube、新しいタブで開きます）</span></a>
              ) : `${work.title} / ${work.artist} (${responsibilities(work)})`}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</SiteLayout>

<style>
  .profile-name { margin: 0 0 16px; font: 400 28px/1.3 var(--font-display); letter-spacing: .14em; }
  .profile-biography { margin-bottom: 20px; }
  .profile-biography p { margin: 0 0 8px; }
  .profile-biography__note { white-space: nowrap; }
  .profile-biography__note a { text-decoration: underline; text-underline-offset: 3px; }
  .profile-socials { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 42px; }
  .profile-socials a { display: inline-flex; align-items: center; min-height: 38px; padding: 6px 17px; border: 1px solid var(--color-ink-soft); border-radius: 3px; font: 400 14px/1.5 var(--font-display); letter-spacing: .06em; transition: background var(--duration-fast); }
  .profile-socials a:hover { background: var(--color-selected-hover); }
  .profile-discography + .profile-discography { margin-top: 38px; }
  .profile-discography__heading { display: flex; align-items: center; gap: 22px; margin-bottom: 18px; }
  .profile-discography h2 { margin: 0; flex-shrink: 0; font-size: 21px; font-weight: 500; letter-spacing: .06em; }
  .profile-discography__rule { position: relative; flex: 1; height: 1px; --ink-color: var(--color-ink-soft); --ink-weight: .6; }
  .profile-discography ul { margin: 0; padding: 0; list-style: none; }
  .profile-discography li { margin-bottom: 5px; line-height: 1.65; overflow-wrap: anywhere; color: var(--color-ink-copy); }
  .profile-discography a { text-decoration: none; transition: color var(--duration-fast); }
  .profile-discography a:hover { color: var(--color-ink); }
  .profile-discography__credits { display: inline-block; font-size: .92em; }
</style>
