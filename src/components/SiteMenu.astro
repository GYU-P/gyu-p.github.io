---
import Icon from './Icon.astro';
import InkBorder from './InkBorder.astro';
import StatusLight from './StatusLight.astro';
import { navigation, site, type PageId } from '../data/site';
interface Props { currentPage: PageId; overlay?: boolean; }
const { currentPage, overlay = false } = Astro.props;
---
<aside class:list={['site-menu', 'paper-panel', { 'site-menu--overlay': overlay }]} aria-label="サイトメニュー" data-primary-menu={!overlay ? '' : undefined}>
  <div class="site-menu__mobile-heading">
    <span class="site-menu__heading-line" aria-hidden="true">✦<i><InkBorder shape="line" /></i></span>
    <a class="site-menu__mobile-brand" href={navigation[0].href} aria-label={`${site.name} — WORKSへ`}><span class="site-menu__mobile-portrait"><img src={site.avatar} alt="" width="64" height="64" /><InkBorder shape="circle" /><InkBorder shape="circle" outer /></span><span>{site.name}</span></a>
    <span class="site-menu__heading-line" aria-hidden="true"><i><InkBorder shape="line" /></i>✦</span>
  </div>
  <div class="site-menu__decoration" aria-hidden="true">
    <div class="site-menu__header-lines"><i><InkBorder shape="line" /></i><i><InkBorder shape="line" /></i></div>
    <div class="site-menu__dots">{Array.from({ length: 8 }, () => <i></i>)}</div>
  </div>
  <nav class="site-menu__navigation" aria-label="メインナビゲーション">
    {navigation.map(item => (
      <a class="site-menu__link" href={item.href} aria-current={currentPage === item.id ? 'page' : undefined}>
        <span class="site-menu__icon"><Icon name={item.id} /></span>
        <span class="site-menu__label">{item.label}</span>
        <StatusLight />
        <InkBorder />
      </a>
    ))}
  </nav>
  {!overlay && <div class="site-menu__rules" aria-hidden="true"><i><InkBorder shape="line" /></i><i><InkBorder shape="line" /></i><i><InkBorder shape="line" /></i></div>}
  <a class="site-menu__identity" href={navigation[0].href} aria-label={`${site.name} — WORKSへ`}>
    <span class="site-menu__portrait"><img src={site.avatar} alt="" width="210" height="210" /><InkBorder shape="circle" /><InkBorder shape="circle" outer /></span>
    <span class="site-menu__name">{site.name}</span>
    <span class="site-menu__dash" aria-hidden="true"></span>
    <span class="site-menu__signature" aria-hidden="true">✦<i><InkBorder shape="line" /></i>✦</span>
  </a>
  {!overlay && <><InkBorder shape="vertical" /><span class="paper-edge paper-edge--bottom" aria-hidden="true"><InkBorder shape="line" /></span></>}
</aside>

<style>
  .site-menu { --decoration-ink-weight: .68; --decoration-ink-texture: 1.5; --decoration-ink-density: var(--ink-density-standard); --decoration-ink-color: var(--color-ink-decoration); position: relative; display: flex; flex-direction: column; padding: 25px 23px 22px; overflow: hidden; min-height: 0; }
  .site-menu__decoration { height: 35px; display: flex; gap: 16px; align-items: stretch; }
  .site-menu__header-lines { position: relative; flex: 1; }
  .site-menu__header-lines > i, .site-menu__rules > i, .site-menu__signature i { --ink-weight: var(--decoration-ink-weight); --ink-texture: var(--ink-texture-sidebar-lines); --ink-density: var(--decoration-ink-density); --ink-color: var(--decoration-ink-color); position: relative; height: 1px; }
  .site-menu__header-lines > i { position: absolute; left: 0; right: 0; }
  .site-menu__header-lines > i:first-child { top: 2px; }
  .site-menu__header-lines > i:last-child { top: 29px; }
  .site-menu__header-lines > i:not(.ink-border-ready)::before { content: ''; position: absolute; inset: 0; background: var(--color-ink-border); opacity: .75; }
  .site-menu__dots { display: grid; grid-template: repeat(4, 4px) / repeat(2, 4px); gap: 5px 6px; flex: 0 0 14px; }
  .site-menu__dots i { width: 4px; height: 4px; border-radius: 50%; background: var(--color-muted); }
  .site-menu__navigation { display: grid; gap: 9px; margin-top: 64px; }
  .site-menu__link { position: relative; display: grid; grid-template-columns: 31px minmax(0, 1fr) 14px; align-items: center; gap: 16px; min-height: 84px; padding: 0 13px 0 19px; border: 1px solid var(--color-line); border-radius: 4px; background: var(--paper-surface); box-shadow: var(--shadow-control); transition: box-shadow var(--duration-fast); }
  .site-menu__link:hover { box-shadow: none; }
  .site-menu__icon { display: grid; place-items: center; width: 31px; height: 31px; background: var(--color-ink); color: var(--color-paper); border-radius: 3px; box-shadow: none; }
  .site-menu__icon :global(svg) { width: 24px; height: 24px; }
  .site-menu__label { min-width: 0; font: var(--font-weight-display) 19px/1 var(--font-display); letter-spacing: .04em; white-space: nowrap; }
  .site-menu__rules { display: grid; gap: 8px; height: 20px; margin: auto 0; }
  .site-menu__rules > i:nth-child(2) { --ink-weight: .44; }
  .site-menu__identity { display: flex; flex-direction: column; align-items: center; margin-bottom: 12px; padding-bottom: 0; }
  .site-menu__portrait { position: relative; width: min(210px, 100%); aspect-ratio: 1; border-radius: 50%; background: url('/images/watercolor.png') 7% 27% / auto 500% no-repeat; }
  .site-menu__portrait img { width: 100%; height: 100%; border-radius: 50%; }
  .site-menu__portrait :global(ink-border[data-outer]), .site-menu__mobile-portrait :global(ink-border[data-outer]) { --ink-weight: .65; --ink-color: var(--color-ink-edge); --ink-texture: var(--ink-texture-strong); --ink-density: var(--ink-density-standard); }
  .site-menu__name { margin-top: 12px; padding-left: .34em; font: var(--font-weight-display) 20px/1 var(--font-display); letter-spacing: .34em; }
  .site-menu__dash { width: 48px; height: 6px; border-radius: 8px; margin: 11px 0 8px; background: var(--color-ink-soft); opacity: .78; }
  .site-menu__signature { display: flex; align-items: center; gap: 8px; width: 100%; margin-top: 14px; font-size: 12px; }
  .site-menu__signature i { flex: 1; }
  .site-menu__mobile-heading { display: none; }
  @media (min-width: 841px) and (max-height: 760px) {
    .site-menu__decoration { height: 20px; }
    .site-menu__navigation { margin-top: 32px; gap: 7px; }
    .site-menu__link { min-height: clamp(44px, 9.5dvh, 84px); }
    .site-menu__rules { margin: auto 0; }
    .site-menu__portrait { width: min(170px, 100%, 25dvh); }
    .site-menu__signature { margin-top: 7px; }
  }
  @media (max-width: 840px) {
    .site-menu:not(.site-menu--overlay) { position: relative; z-index: 1; flex-direction: column; align-items: stretch; gap: 12px; height: auto; padding: 20px 12px 12px; overflow: visible; }
    .site-menu:not(.site-menu--overlay) :is(.site-menu__decoration, .site-menu__rules, .site-menu__identity) { display: none; }
    .site-menu:not(.site-menu--overlay) .site-menu__mobile-heading { display: flex; align-items: center; gap: 12px; padding: 4px 0; }
    .site-menu__heading-line { display: flex; flex: 1; align-items: center; gap: 5px; min-width: 0; font-size: 11px; }
    .site-menu__heading-line i { position: relative; flex: 1; height: 1px; --ink-weight: var(--decoration-ink-weight); --ink-texture: var(--decoration-ink-texture); --ink-density: var(--decoration-ink-density); --ink-color: var(--decoration-ink-color); }
    .site-menu__mobile-brand { display: flex; align-items: center; justify-content: center; gap: 16px; font: var(--font-weight-display) 20px/1 var(--font-display); letter-spacing: .25em; white-space: nowrap; }
    .site-menu__mobile-portrait { position: relative; width: 64px; height: 64px; border-radius: 50%; background: url('/images/watercolor.png') 7% 27% / auto 500% no-repeat; }
    .site-menu__mobile-portrait img { width: 100%; height: 100%; border-radius: 50%; }
    .site-menu__mobile-portrait :global(ink-border[data-outer]) { inset: -7px; }
    .site-menu:not(.site-menu--overlay) .site-menu__navigation { flex: 1; min-width: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; gap: 4px; }
    .site-menu:not(.site-menu--overlay) .site-menu__link { display: flex; justify-content: center; padding: 0; min-height: 40px; }
    .site-menu:not(.site-menu--overlay) .site-menu__link :global(.status-light) { position: absolute; right: 6px; width: 10px; height: 10px; flex-basis: 10px; }
    .site-menu:not(.site-menu--overlay) .site-menu__link[aria-current='page'] :global(.status-light) { border-width: 3px; }
    .site-menu:not(.site-menu--overlay) .site-menu__icon { position: absolute; left: 10px; width: 16px; height: 18px; }
    .site-menu:not(.site-menu--overlay) .site-menu__icon :global(svg) { width: 14px; height: 14px; }
    .site-menu:not(.site-menu--overlay) .site-menu__label { font-size: 11px; letter-spacing: 0; }
    .site-menu--overlay { width: min(420px, 100%); min-height: 100dvh; margin: auto; padding: 60px 28px 24px; box-shadow: none; }
    .site-menu--overlay .site-menu__navigation { margin-top: 28px; }
    .site-menu--overlay .site-menu__link { min-height: 64px; padding-left: 25px; }
    .site-menu--overlay .site-menu__portrait { width: min(180px, 24dvh); }
    .site-menu--overlay .site-menu__identity { margin-top: auto; padding-top: 28px; }
  }
</style>
