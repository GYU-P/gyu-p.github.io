---
interface Props { name: 'works' | 'profile' | 'contact' | 'search'; }
const { name } = Astro.props;
---
<svg viewBox="0 0 32 32" fill="none" aria-hidden="true" focusable="false">
  {name === 'works' && <>
    <path d="M11.4 9.4 25.9 6.8v15.5M11.4 9.4v16M11.4 12.9 25.9 10.3" stroke="currentColor" stroke-width="2.55" stroke-linecap="round" stroke-linejoin="round" />
    <ellipse cx="7.8" cy="25.4" rx="4.5" ry="3.1" fill="currentColor" transform="rotate(-16 7.8 25.4)" />
    <ellipse cx="22.25" cy="22.3" rx="4.5" ry="3.1" fill="currentColor" transform="rotate(-16 22.25 22.3)" />
  </>}
  {name === 'profile' && <path d="M16 5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM16 19c-7 0-11 3.4-11 8h22c0-4.6-4-8-11-8Z" fill="currentColor" />}
  {name === 'contact' && <path d="m5 10 11 10 11-10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'search' && <>
    <circle cx="14" cy="14" r="8" stroke="currentColor" stroke-width="2" />
    <path d="m20 20 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </>}
</svg>
