{
  "name": "gyup-site",
  "version": "1.0.0",
  "description": "GYU P music portfolio",
  "scripts": {
    "test": "playwright test",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "sync:works": "node --env-file-if-exists=.env scripts/sync-works.mjs",
    "update:works": "node scripts/update-works-local.mjs",
    "prepare:works": "node scripts/update-works-local.mjs --prepare-only",
    "apply:works": "node scripts/review-works.mjs apply",
    "update:views": "node --env-file-if-exists=.env scripts/update-view-counts.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "astro": "^7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@playwright/test": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
